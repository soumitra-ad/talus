# Example Streamlit secrets file for TALUS.
#
# Copy the keys you need into the "Secrets" box under Advanced settings when deploying on
# Streamlit Community Cloud (Settings -> Secrets), or into a local .streamlit/secrets.toml for
# testing the Cloud secrets path locally. NEVER commit a real secrets.toml -- it is already
# git-ignored (see .gitignore). Every key below is optional; TALUS runs in offline
# deterministic demo mode with none of them set.
#
# Streamlit exposes each root-level key below both as st.secrets["KEY"] and as a regular
# process environment variable (os.environ["KEY"]), which is how terrain_agent.config reads
# all of these -- identical to a local .env file.

# --- Google Gemini (optional; enables live natural-language chat) -----------
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3.6-flash"

# --- Deployment environment ---------------------------------------------------
# "production" applies production-safe defaults (e.g. NASA downloads off unless enabled below).
TALUS_ENV = "production"

# --- NASA DEM acquisition -----------------------------------------------------
# Off by default when TALUS_ENV=production; set to "true" to allow the deployed app to fetch
# DEMs from NASA ODE / PDS Geosciences on demand.
TALUS_NASA_DOWNLOADS = "true"

# --- Optional access gate -----------------------------------------------------
# If set, visitors must enter this token before the app renders (see streamlit_app.py). An
# unguessable Streamlit Cloud URL is not by itself a security control.
TALUS_ACCESS_TOKEN = ""
